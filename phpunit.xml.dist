<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         backupGlobals="false">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">Test/Unit</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">src/Api</directory>
            <directory suffix=".php">src/Console</directory>
            <directory suffix=".php">src/Model</directory>
            <directory suffix=".php">src/Observer</directory>
            <directory suffix=".php">src/Plugin</directory>
            <directory suffix=".php">src/Service</directory>
        </include>
        <exclude>
            <!-- Deprecated and unused, removal planned for 2.0.0 -->
            <file>src/Service/MessageProcessor.php</file>
        </exclude>
    </coverage>
</phpunit>
