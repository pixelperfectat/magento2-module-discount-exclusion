{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "etc",
            "i18n",
            "view",
            "registration.php",
            "Service/MessageProcessor.php"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "var/infection.log"
    },
    "mutators": {
        "@default": true
    }
}
